FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app/backend
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements*.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
      --index-url https://pypi.org/simple \
      --retries 10 \
      --timeout 120 \
      --no-deps \
      opencv-contrib-python==4.10.0.84 \
    && grep -v '^opencv-contrib-python==' requirements-ocr.txt > /tmp/requirements-ocr-no-opencv.txt \
    && python -m pip install \
      --index-url https://mirrors.aliyun.com/pypi/simple/ \
      --trusted-host mirrors.aliyun.com \
      --retries 10 \
      --timeout 120 \
      -r /tmp/requirements-ocr-no-opencv.txt \
      gunicorn==23.0.0 \
    && rm -f /tmp/requirements-ocr-no-opencv.txt
COPY backend/ ./
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "2", "--timeout", "900", "--access-logfile", "-", "app:app"]
