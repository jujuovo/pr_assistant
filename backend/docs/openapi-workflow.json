{
  "openapi": "3.0.3",
  "info": {
    "title": "推免权威计分与排名工作流",
    "version": "2.0.0",
    "description": "后端是状态、计分、范围、版本和排名的唯一权威来源。"
  },
  "x-ranking-contract": {
    "states": [
      "draft",
      "stale",
      "frozen",
      "correction_required",
      "published",
      "withdrawn"
    ],
    "commands": [
      "generate",
      "freeze",
      "request_correction",
      "publish",
      "withdraw",
      "create_successor"
    ],
    "required_command_fields": [
      "version",
      "idempotency_key"
    ],
    "presentation_fields": [
      "batch_id",
      "scope",
      "status",
      "version",
      "generated_at",
      "updated_at",
      "published_at",
      "reason_code",
      "allowed_actions"
    ],
    "roles": {
      "student": "personal entry only",
      "teacher": "authorized full list, read only",
      "admin": "authorized full list and lifecycle commands"
    },
    "audit": [
      "RankingCommand",
      "RankingStateEvent",
      "RankingExportAudit"
    ]
  },
  "paths": {
    "/api/workflow/rankings/generate": {
      "post": {
        "summary": "生成排名草稿"
      }
    },
    "/api/workflow/rankings/{batch_id}": {
      "get": {
        "summary": "按角色读取排名批次"
      }
    },
    "/api/workflow/rankings/{batch_id}/commands/{action}": {
      "post": {
        "summary": "执行单一排名状态命令"
      }
    },
    "/api/workflow/rankings/{batch_id}/export": {
      "post": {
        "summary": "审计导出完整名单"
      }
    },
    "/api/workflow/students/{student_id}/score-sources/{source_type}/{source_id}": {
      "get": {
        "summary": "只读查看计分明细对应项目详情，验证学生及学院、周期和计分来源关联",
        "parameters": [
          {
            "in": "query",
            "name": "year",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "项目申报信息、原件受保护链接、OCR结果及审核记录"
          },
          "400": {
            "description": "无效周期"
          },
          "403": {
            "description": "无权访问"
          },
          "404": {
            "description": "该周期没有对应可见计分来源或原材料不存在"
          }
        }
      }
    }
  },
  "x-score-readable-metadata": {
    "rule_versions": "后端解析的规则名称及真实版本，reference保留内部标识，客户端不将负标识当作版本号",
    "entries.project_source.name": "当前授权学生的实际申报项目名称，来源缺失时可省略",
    "entries.rule_label": "对应固定规则或竞赛规则包的中文名称与真实版本",
    "timestamps": "接口保留UTC ISO格式，页面统一以北京时间年月日时分秒展示",
    "scoring": "仅新增只读说明，不修改计分或快照"
  }
}
